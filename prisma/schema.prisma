// ────────────────────────────────────────────────────────────
// SkillSetu — Prisma schema
// Datasource: Supabase PostgreSQL
//
// ROLE OF THIS FILE:
//   This schema is the canonical source of truth for the database
//   structure (tables, columns, relations, indexes). It is pushed
//   to Supabase with `bun run db:push` (see docs/deployment.md).
//
//   Runtime data access in the application uses the Supabase JS
//   client (src/lib/supabase/*) over HTTPS — not Prisma Client —
//   because the sandbox blocks raw TCP (port 5432) while HTTPS
//   (port 443) works. See docs/architecture.md §"Data Access".
//
// The full entity model (identity, taxonomy, content, assessment,
// learner, editorial, commerce, seo/ops) is added in sessions S2 & S3.
// ────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models are added starting in S2 (Identity, Taxonomy, Content)
// and S3 (Assessment, Learner, Editorial, Commerce, SEO/Ops).
