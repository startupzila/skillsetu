# ────────────────────────────────────────────────────────────
# SkillSetu — Environment Variables (template)
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# Only this file (.env.example) ships with placeholders.
# ────────────────────────────────────────────────────────────

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────
# Project URL, e.g. https://nuzxwzacqiwjkrmyttic.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon (publishable) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Supabase Postgres direct connection, used by Prisma) ──
# Format: postgresql://postgres:<PASSWORD>@<host>:5432/postgres
DATABASE_URL=

# ── Optional (added when the integration is implemented) ─────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# EMAIL_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_KEY=
