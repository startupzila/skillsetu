# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# ── SkillSetu: local dev artifacts & sandbox infra (not part of the product) ──
# local SQLite database (we use Supabase Postgres in production)
db/*.db
db/*.db-journal

# sandbox gateway / dev tooling (environment-specific, not the product)
Caddyfile
.zscripts/
run-dev.sh

# sandbox runtime build scripts (these are NOT project tests)
tests/*.sh

# reference examples (websocket demo, not part of SkillSetu product)
/examples/

# sandbox-only working directories (generated artifacts, uploads, mini-service runtimes)
tool-results/
upload/
download/
mini-services/

# OS / editor
.DS_Store
Thumbs.db